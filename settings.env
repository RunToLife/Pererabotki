# Настройки сервиса "Переработка". Формат: КЛЮЧ=значение, строки с # — комментарии.
# Переменные окружения Windows/Linux имеют приоритет над этим файлом.
# После изменения перезапустите сервис (повторно запустите install.bat или перезайдите в Windows).
# Подробно — README.md, раздел «Определение пользователя (Windows / Active Directory)».

# Адрес прослушивания: 127.0.0.1 — только этот компьютер, 0.0.0.0 — доступ из сети.
# Внимание: install.bat передаёт свой PERER_HOST (по умолчанию 127.0.0.1) через окружение,
# поэтому для доступа из сети запускайте: set PERER_HOST=0.0.0.0 & install.bat
#PERER_HOST=0.0.0.0
#PERER_PORT=8080

# Как определять пользователя:
#   auto    — (по умолчанию) сетевые пользователи входят по учётке Windows/AD (NTLM/Kerberos),
#             на самом сервере — учётка, под которой запущен сервис
#   windows — все, включая localhost (например, терминальный сервер), только по учётке Windows/AD
#   proxy   — имя из заголовка X-Remote-User от обратного прокси (IIS/Apache/nginx с SSO)
#   off     — без входа Windows: учётка сервиса на localhost и ручной ввод имени
#PERER_AUTH=auto

# Kerberos вместо NTLM (1 — включить). Нужен SPN: setspn -S HTTP/<имя-сервера> <учётка сервиса>
# Без SPN оставьте 0: браузер войдёт по NTLM, это работает без настройки домена.
#PERER_KERBEROS=0

# Разрешить вводить имя вручную, если учётку определить не удалось (1 — да, 0 — нет).
# По умолчанию 1, а в режиме windows — 0 (без учётки Windows изменения запрещены).
#PERER_ALLOW_MANUAL=1
